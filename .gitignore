############################################
# JMeter (NO versionar instalación/binarios)
############################################
apache-jmeter-*/
**/apache-jmeter-*/

# Logs/artefactos típicos de JMeter
**/jmeter.log
**/jmeter-server.log
**/*.jtl
**/report/
**/reports/
**/results/
**/output/

# Temporales/backups comunes
**/backups/
**/*.tmp
**/*.bak
**/*.swp
**/*~

############################################
# Newman / Postman (versiona colecciones, no reportes)
############################################
**/newman/reports/
**/newman/*.html
**/newman/*.xml
**/newman/*.json

############################################
# Python (NO versionar venv/cache)
############################################
**/.venv/
**/venv/
**/env/
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.coverage
**/coverage.xml
**/htmlcov/

############################################
# Logs generales
############################################
**/logs/
**/*.log

############################################
# OS / IDE
############################################
.DS_Store
Thumbs.db
.idea/
.vscode/
*.iml

############################################
# Secretos / credenciales (si aplica)
############################################
.env
.env.*
*.key
*.pem
