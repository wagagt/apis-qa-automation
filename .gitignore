# =========================
# Logs
# =========================
/logs/
*.log


# =========================
# Postman: version collections, ignore environments/globals
# =========================
# Keep collections tracked (do NOT ignore):
# *.postman_collection.json

# Ignore environments/globals (usually contain tokens/URLs)
*environment*.json
*globals*.json
postman_environment*.json
postman_globals*.json

# Allow sanitized examples
!*environment*.example.json
!postman_environment.example.json
!postman_globals.example.json

